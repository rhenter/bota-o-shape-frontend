{
  "name": "bota-o-shape-frontend",
  "private": true,
  "packageManager": "yarn@4.4.1",
  "workspaces": [
    "apps/gym_admin",
    "apps/portal",
    "apps/saas_admin"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "devDependencies": {
    "railway": "^3.16.0"
  },
  "scripts": {
    "dev": "yarn workspace @bota-o-shape/gym-admin dev",
    "build": "yarn workspace @bota-o-shape/gym-admin build",
    "start": "yarn workspace @bota-o-shape/gym-admin start",
    "lint": "yarn workspace @bota-o-shape/gym-admin lint",
    "test": "yarn workspace @bota-o-shape/gym-admin test",
    "portal:dev": "yarn workspace @bota-o-shape/portal dev",
    "saas:dev": "yarn workspace @bota-o-shape/saas-admin dev",
    "saas:build": "yarn workspace @bota-o-shape/saas-admin build",
    "saas:lint": "yarn workspace @bota-o-shape/saas-admin lint",
    "saas:test": "yarn workspace @bota-o-shape/saas-admin test",
    "test:coverage": "yarn workspace @bota-o-shape/gym-admin test:coverage"
  }
}
