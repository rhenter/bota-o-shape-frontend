# API used by the Next.js server (plans) and the same-origin /api proxy (signup).
API_BASE_URL=http://127.0.0.1:8006/
# Where the academy dashboard (apps/gym_admin) is served.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
# Public URL of this portal (canonical/Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Comma-separated hosts that serve the SaaS portal; any other host is resolved as an academy custom domain.
PORTAL_HOSTS=
